
#!/usr/bin/env python3



import rclpy

from rclpy.node import Node

from sensor_msgs.msg import Image, CompressedImage

from std_msgs.msg import String

from cv_bridge import CvBridge

import cv2

import os

import sys

import select

from datetime import datetime



class CaptureAndPublish(Node):

    def __init__(self):

        super().__init__('capture_and_publish')

        

        self.bridge = CvBridge()

        self.latest_image = None

        self.image_received = False

        

        self.camera_topic = "/image"

        

        qos_profile = rclpy.qos.QoSProfile(

            reliability=rclpy.qos.ReliabilityPolicy.BEST_EFFORT,

            durability=rclpy.qos.DurabilityPolicy.VOLATILE,

            depth=10

        )

        

        self.sub_image = self.create_subscription(

            CompressedImage, self.camera_topic, self.image_callback, qos_profile)

        

        # ★★★ 改为发布CompressedImage ★★★

        self.pub_sign_image = self.create_publisher(CompressedImage, '/sign_image', 10)

        

        self.result_sub = self.create_subscription(

            String, '/sign_result', self.result_callback, 10)

        

        self.get_logger().info("=" * 60)

        self.get_logger().info("📷 小车拍照发布节点已启动")

        self.get_logger().info(f"📡 订阅摄像头: {self.camera_topic} (CompressedImage)")

        self.get_logger().info(f"📡 发布到: /sign_image (CompressedImage)")

        self.get_logger().info("=" * 60)

        self.get_logger().info("按 Enter 键拍照并发布")

        self.get_logger().info("按 Ctrl+C 退出")

        

        self.create_timer(2.0, self.check_image_status)

        self.status_printed = False

    

    def check_image_status(self):

        if not self.image_received and not self.status_printed:

            self.get_logger().warn(f"⚠️ 还未收到 {self.camera_topic} 的图像")

            self.status_printed = True

        elif self.image_received and not self.status_printed:

            self.get_logger().info("✅ 已成功接收到摄像头图像!")

            self.status_printed = True

    

    def image_callback(self, msg):

        self.latest_image = msg

        self.image_received = True

        if not self.status_printed:

            self.get_logger().info("✅ 收到第一帧图像!")

            self.status_printed = True

    

    def result_callback(self, msg):

        self.get_logger().warn(f"📢 识别结果: {msg.data}")

        print(f"\n{'='*60}")

        print(f"📢 识别结果: {msg.data}")

        print(f"{'='*60}\n")

    

    def capture_and_publish(self):

        """拍照并发布到 /sign_image"""

        if not self.image_received or self.latest_image is None:

            self.get_logger().warn("❌ 还没有收到摄像头图像，请检查摄像头话题")

            return False

        

        self.get_logger().info("📸 拍照中...")

        

        try:

            # 从CompressedImage解码用于保存

            cv_image = self.bridge.compressed_imgmsg_to_cv2(self.latest_image, 'bgr8')

            

            # 保存图片

            save_dir = "/tmp/captured_images"

            os.makedirs(save_dir, exist_ok=True)

            timestamp = datetime.now().strftime("%Y%m%d_%H%M%S")

            save_path = os.path.join(save_dir, f"capture_{timestamp}.jpg")

            cv2.imwrite(save_path, cv_image)

            self.get_logger().info(f"💾 图片已保存: {save_path}")

            

            # ★★★ 直接发布原始的CompressedImage ★★★

            self.pub_sign_image.publish(self.latest_image)

            self.get_logger().info("📤 图像已发布到 /sign_image (CompressedImage)")

            self.get_logger().info("⏳ 等待笔记本识别...")

            

            return True

            

        except Exception as e:

            self.get_logger().error(f"❌ 拍照失败: {e}")

            import traceback

            traceback.print_exc()

            return False



def main():

    rclpy.init()

    node = CaptureAndPublish()

    

    print("\n📷 按 Enter 键拍照并发送到笔记本识别")

    print("输入 'q' 然后按 Enter 退出\n")

    

    while rclpy.ok():

        rclpy.spin_once(node, timeout_sec=0.1)

        

        if sys.stdin in select.select([sys.stdin], [], [], 0)[0]:

            cmd = sys.stdin.readline().strip()

            if cmd.lower() == 'q':

                break

            elif cmd == '':

                node.capture_and_publish()

    

    node.destroy_node()

    rclpy.shutdown()

    print("\n✅ 已退出")



if __name__ == '__main__':

    main()

